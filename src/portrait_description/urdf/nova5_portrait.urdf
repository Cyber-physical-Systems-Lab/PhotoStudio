    <child link="Link2"/>
    <axis xyz="0 0 1"/>
    <limit effort="300" lower="-3.14" upper="3.14" velocity="100"/>
  </joint>
  <link name="Link3">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.152357289724291 -0.0053571688729055 0.0198991511385547"/>
      <mass value="1.40745649848125"/>
      <inertia ixx="0.00100801309674517" ixy="-0.00077546601599374" ixz="4.43267247578911E-05" iyy="0.0231741793950995" iyz="1.31338010910521E-06" izz="0.02359962285525"/>
