    <child link="Link6"/>
    <axis xyz="0 0 1"/>
    <limit effort="300" lower="-6.28" upper="6.28" velocity="100"/>
  </joint>
  <!-- Tool flange: fixed joint from Link6 to tool_link -->
  <link name="tool_link"/>
  <joint name="flange" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="Link6"/>
    <child link="tool_link"/>
  </joint>

  <!-- Webcam mount. The default offset below is a placeholder: measure it on the real
       bracket (or run hand-eye calibration) and update config/camera_mount.yaml, which the
       arm node uses for kinematics. This URDF copy is only for visualisation and Isaac Sim. -->
  <link name="camera_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.015"/>
      <geometry><box size="0.10 0.03 0.03"/></geometry>
      <material name="webcam_black"><color rgba="0.05 0.05 0.05 1"/></material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.015"/>
      <geometry><box size="0.10 0.03 0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="camera_mount" type="fixed">
    <origin rpy="0 0 0" xyz="0 -0.06 0.02"/>
    <parent link="tool_link"/>
    <child link="camera_link"/>
  </joint>
  <!-- Optical frame (z forward, x right, y down) at the lens. -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.03"/>
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
  </joint>
</robot>
