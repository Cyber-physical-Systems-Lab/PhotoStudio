      <inertia ixx="0.00285193319464959" ixy="-0.00212784400881843" ixz="-0.00109906472415148" iyy="0.0636767872390402" iyz="-3.83872488712299E-05" izz="0.0643005121111712"/>
    </inertial>
    <visual>
