      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://portrait_description/meshes/nova5/Link1.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint1" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0.240000000000178"/>
    <parent link="base_link"/>
    <child link="Link1"/>
    <axis xyz="0 0 0.999999999999855"/>
    <limit effort="300" lower="-6.28" upper="6.28" velocity="100"/>
  </joint>
  <link name="Link2">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.19933810729628 -0.00696463483971123 0.109208661556353"/>
