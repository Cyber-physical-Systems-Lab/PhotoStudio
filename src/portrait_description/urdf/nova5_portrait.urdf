    <child link="Link3"/>
    <axis xyz="0 0 1"/>
    <limit effort="300" lower="-2.79" upper="2.79" velocity="100"/>
  </joint>
  <link name="Link4">
    <inertial>
      <origin rpy="0 0 0" xyz="-6.37112093033953E-06 -0.0227590499933018 -0.0202381689250349"/>
      <mass value="0.439666284541787"/>
      <inertia ixx="0.000634738696193051" ixy="1.33529119545257E-08" ixz="2.91412587537874E-08" iyy="0.00045014395177395" iyz="0.000210919680187578" izz="0.000480311391216564"/>
