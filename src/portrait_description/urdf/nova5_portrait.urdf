<?xml version="1.0"?>
<!-- Nova 5 kinematics from the hardware-validated TouchDrive description (joint1/joint4 axes +z),
     gripper removed, flange webcam added. -->
<robot name="nova5_portrait">
  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="6.56698714338847E-06 2.73052159273858E-06 0.0698223124889706"/>
      <mass value="1.3106443915978"/>
      <inertia ixx="0.00308109148952278" ixy="-4.0369958400766E-08" ixz="5.2607663395944E-07" iyy="0.00309758743296662" iyz="-6.37484696538659E-09" izz="0.00232835367593981"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://portrait_description/meshes/nova5/base_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://portrait_description/meshes/nova5/base_link.STL"/>
      </geometry>
    </collision>
  </link>
  <link name="Link1">
    <inertial>
      <origin rpy="0 0 0" xyz="9.18642704220017E-06 -0.021770784235076 -0.0261833991373472"/>
      <mass value="1.08090940330212"/>
