  <joint name="joint5" type="revolute">
    <origin rpy="1.5708 0 0" xyz="0 -0.12 0"/>
    <parent link="Link4"/>
    <child link="Link5"/>
    <axis xyz="0 0 1"/>
    <limit effort="300" lower="-6.28" upper="6.28" velocity="100"/>
  </joint>
  <link name="Link6">
    <inertial>
      <origin rpy="0 0 0" xyz="1.5476173180832E-06 0.000151598525687691 -0.0194592287865595"/>
      <mass value="0.129679940383395"/>
      <inertia ixx="5.02803124561327E-05" ixy="6.27222112028976E-11" ixz="3.5128727780266E-12" iyy="5.05400746124736E-05" iyz="5.0343678900728E-08" izz="7.7863015024978E-05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
